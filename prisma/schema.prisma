generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── NextAuth.js core tables ───────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

// ── App domain ─────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  name          String?
  image         String?
  role          UserRole  @default(READER)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts      Account[]
  sessions      Session[]
  instrumentNotes InstrumentNote[]
  cellNotes     CellNote[]

  @@map("users")
}

enum UserRole {
  READER   // public read (must be signed in, but no edit rights)
  EDITOR   // can tag, write notes, triage instruments
  ADMIN    // can manage users, full access

  @@map("user_role")
}

model Jurisdiction {
  id          String   @id @default(cuid())
  code        String   @unique // "US", "CA", "TX", etc.
  name        String   // "United States", "California", "Texas"
  level       JurisdictionLevel
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  instruments Instrument[]
  cellNotes   CellNote[]

  @@map("jurisdictions")
}

enum JurisdictionLevel {
  FEDERAL
  STATE

  @@map("jurisdiction_level")
}

model IssueTag {
  id          String   @id @default(cuid())
  slug        String   @unique // machine id: "coverage", "athletics", etc.
  label       String   // human label: "Who is covered"
  sortOrder   Int      @map("sort_order")
  description String?  // optional longer explanation
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  instrumentTags InstrumentIssueTag[]
  cellNotes      CellNote[]

  @@map("issue_tags")
}

// ── Instruments (extensible type) ──────────────────────────

model Instrument {
  id                String           @id @default(cuid())
  jurisdictionId    String           @map("jurisdiction_id")
  type              InstrumentType   // Prisma enum — adding a value requires a migration
  identifier        String           // bill number, CFR cite, chapter, etc.
  title             String
  status            InstrumentStatus
  triageStatus      TriageStatus     @default(UNREVIEWED) @map("triage_status")
  source            String?          @map("source")
  sourceId          String?          @map("source_id")
  introducedAt      DateTime?        @map("introduced_at")
  passedAt          DateTime?        @map("passed_at")
  effectiveAt       DateTime?        @map("effective_at")
  sourceUrl         String?          @map("source_url")
  rawSummary        String?          @map("raw_summary") // from API, unverified
  lastCheckedAt     DateTime?        @map("last_checked_at")
    relevanceConfidence Int?           @map("relevance_confidence") // 0-100
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  jurisdiction   Jurisdiction       @relation(fields: [jurisdictionId], references: [id])
  issueTags      InstrumentIssueTag[]
  notes          InstrumentNote[]

  @@unique([jurisdictionId, type, identifier])
  @@unique([source, sourceId])
  @@index([jurisdictionId, status])
  @@index([triageStatus, status])
    @@index([type])
  @@index([lastCheckedAt])
  @@map("instruments")
}

enum TriageStatus {
  UNREVIEWED
  RELEVANT
  NOT_RELEVANT

  @@map("triage_status")
}

// Instrument types. Adding a value requires a Prisma migration.
// V1: BILL, STATUTE, REGULATION
// Future: GUIDANCE, EXECUTIVE_ORDER, COURT_ORDER
enum InstrumentType {
  BILL
  STATUTE
  REGULATION

  @@map("instrument_type")
}

enum InstrumentStatus {
  PROPOSED
  PASSED
  EFFECTIVE
  ENJOINED
  FAILED
  VETOED
  REPEALED

  @@map("instrument_status")
}

// Junction: which issue tags apply to which instruments
model InstrumentIssueTag {
  instrumentId String @map("instrument_id")
  issueTagId   String @map("issue_tag_id")

  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  issueTag   IssueTag   @relation(fields: [issueTagId], references: [id], onDelete: Cascade)

  @@id([instrumentId, issueTagId])
  @@map("instrument_issue_tags")
}

// ── Notes ──────────────────────────────────────────────────

// Per-instrument editor notes (e.g., triage comments, source verification)
model InstrumentNote {
  id           String   @id @default(cuid())
  instrumentId String   @map("instrument_id")
  authorId     String?  @map("author_id")
  body         String   @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  author     User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@map("instrument_notes")
}

// Per-cell (jurisdiction × issue tag) comparison notes
// These are the human-written comparisons shown in the matrix
model CellNote {
  id             String   @id @default(cuid())
  jurisdictionId String   @map("jurisdiction_id")
  issueTagId     String   @map("issue_tag_id")
  authorId       String?  @map("author_id")
  body           String   @db.VarChar(10000)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  jurisdiction Jurisdiction @relation(fields: [jurisdictionId], references: [id], onDelete: Cascade)
  issueTag     IssueTag     @relation(fields: [issueTagId], references: [id], onDelete: Cascade)
  author       User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([jurisdictionId, issueTagId])
  @@map("cell_notes")
}
